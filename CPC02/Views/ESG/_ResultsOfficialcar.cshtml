@model List<OfficialcarViewModel>
@using CPC02.Models
@using Newtonsoft.Json
<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th>類別</th>
            <th>總公升數(L)</th>
            <th>溫室氣體種類</th>
            <th style="width:150px">係數 (kg CO2e/公升)</th>
            <th>GWP值</th>
            <th style="width:150px">計算結果 (kg CO2e/公升)</th>
            <th style="width:150px">計算結果 (ton CO2e/公秉)</th>
            <th>最終總和 (ton CO2e/公秉)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var dynamicCoefficients = item.GasCoefficients;
            var sumEmission = item.TotalCO2eEmission;

            for (int i = 0; i < dynamicCoefficients.Count; i++)
            {
                var coeff = dynamicCoefficients[i];
                var kgCO2e = item.TotalEmission * coeff.Coefficient1 * coeff.Coefficient2;
                var tonCO2e = kgCO2e / 1000M;

                <tr>
                    @if (i == 0)
                    {
                        <td rowspan="@dynamicCoefficients.Count">@item.Type</td>
                        <td rowspan="@dynamicCoefficients.Count">@item.TotalEmission</td>
                    }
                    <td>@coeff.GasName</td>
                    <td>@coeff.Coefficient1.ToString("F10")</td>
                    <td>@coeff.Coefficient2.ToString("F4")</td>
                    <td>@kgCO2e.ToString("F4")</td>
                    <td>@tonCO2e.ToString("F4")</td>

                    @if (i == 0)
                    {
                        <td rowspan="@dynamicCoefficients.Count">@sumEmission.ToString("F4")</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
