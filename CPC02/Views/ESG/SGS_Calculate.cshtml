@model EsgCalculationPageViewModel
@using CPC02.Models;
@using Newtonsoft.Json
@{
    Layout = "~/Views/Shared/_LayoutMember2.cshtml";
    ViewBag.Title = "數據統計";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/css/esg-calculation.css")" />
}
<main id="app" class="esg-page">
    <form method="get" action="@Url.Action("SGS_Calculate", "ESG")" class="esg-search" aria-label="ESG 數據查詢">
        <div class="esg-field esg-field-category">
            <label for="category">計算類別</label>
            <select id="category" v-model="category" name="category" class="form-control">
                <option value="coldcoal">類別一_冷媒</option>
                <option value="fireextin">類別一_滅火器</option>
                <option value="wd40">類別一_WD40</option>
                <option value="公務車">類別一_公務車</option>
                <option value="diesel">類別一_緊急發電機（柴油）</option>
                <option value="electricity">類別二_電費</option>
                <option value="commuting">類別三_員工通勤</option>
                <option value="traffic">類別三_交通</option>
                <option value="wastetransportation">類別三_廢棄物運輸</option>
                <option value="water">類別四_水費</option>
                <option value="elec_UP">類別四_外購電力上游排放(含運輸)</option>
                <option value="gas_UP">類別四_汽油有關的上游排放</option>
                <option value="diesel_UP">類別四_柴油有關的上游排放</option>
                <option value="waste">類別四_廢棄物</option>
            </select>
        </div>
        <div v-if="category !== 'coldcoal'" class="esg-field">
            <label for="year">盤查年份</label>
            <input id="year" type="number" name="year" class="form-control" v-model="year" min="2024" max="9998" step="1" required />
        </div>
        <div v-if="factoryOptions.length" class="esg-field">
            <label for="factory">廠區</label>
            <select id="factory" name="factory" class="form-control" v-model="factory">
                <option v-for="option in factoryOptions" :key="option" :value="option">{{ option }}</option>
            </select>
        </div>
        <div v-if="methodOptions.length" class="esg-field">
            <label for="methods">{{ category === 'traffic' ? '交通方式' : '處理方式' }}</label>
            <select id="methods" name="methods" class="form-control" v-model="methods">
                <option v-for="option in methodOptions" :key="option" :value="option">{{ option }}</option>
            </select>
        </div>
        <button class="esg-search-button" type="submit">
            <span class="glyphicon glyphicon-search" aria-hidden="true"></span> 查詢數據
        </button>
    </form>
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @if (ViewData.ModelState.IsValid && Model.HasSearched && !Model.Results.Any())
    {
        <p class="text-muted">此查詢條件下沒有資料。</p>
    }
    @if (Model.HasSearched && Model.Results.Any())
    {
        <div class="esg-results">
            <div class="card-body">
                <div class="table-responsive">
                    @if (Model.Results is List<ElectricitySummaryViewModel> electricityModel)
                    {
                        @Html.Partial("_ResultsElectricitySummary", electricityModel)
                    }
                    else if (Model.Results is List<WaterSummaryViewModel> waterModel)
                    {
                        @Html.Partial("_ResultsWaterSummary", waterModel)
                    }
                    else if (Model.Results is List<WasteSummaryViewModel> wasteModel)
                    {
                        @Html.Partial("_ResultsWasteSummary", wasteModel)
                    }
                    else if (Model.Results is List<WastetransportationViewModel> wastetransportationModel)
                    {
                        @Html.Partial("_ResultsWastetransportation", wastetransportationModel)
                    }
                    else if (Model.Results is List<FireExtinViewModel> fireextinModel)
                    {
                        @Html.Partial("_ResultsFireExtin", fireextinModel)
                    }
                    else if (Model.Results is List<WD40ViewModel> WD40Model)
                    {
                        @Html.Partial("_ResultsWD40", WD40Model)
                    }
                    else if (Model.Results is List<ColdCoalViewModel> ColdCoalModel)
                    {
                        @Html.Partial("_ResultsColdCoal", ColdCoalModel)
                    }
                    else if (Model.Results is List<CommutingViewModel> CommutingModel)
                    {
                        @Html.Partial("_ResultsCommuting", CommutingModel)
                    }
                    else if (Model.Results is List<TrafficViewModel> TrafficModel)
                    {
                        @Html.Partial("_ResultsTraffic", TrafficModel)
                    }
                    else if (Model.Results is List<OfficialcarViewModel> OfficialcarViewModel)
                    {
                        @Html.Partial("_ResultsOfficialcar", OfficialcarViewModel)
                    }
                    else if (Model.Results is List<Elec_UPViewModel> elec_UPModel)
                    {
                        @Html.Partial("_ResultsElec_UP", elec_UPModel)
                    }
                    else if (Model.Results is List<Gas_UPViewModel> Gas_UPModel)
                    {
                        @Html.Partial("_ResultsGas_UP", Gas_UPModel)
                    }
                    else if (Model.Results is List<Diesel_UPViewModel> Diesel_UPModel)
                    {
                        @Html.Partial("_ResultsDiesel_UP", Diesel_UPModel)
                    }
                    else if (Model.Results is List<Diesel_ViewModel> DieselModel)
                    {
                        @Html.Partial("_ResultsDiesel_", DieselModel)
                    }
                </div>
            </div>
        </div>
    }
</main>

<script>
    window.esgCalculationConfig = @Html.Raw(JsonConvert.SerializeObject(new {
        search = Model.Search,
        coefficientOptions = Model.CoefficientOptions,
        parameters = Model.Parameters,
        trafficRows = Model.Results as List<TrafficViewModel>
    }, new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml }));
</script>
<script src="@Url.Content("~/Scripts/esg-calculation.js")"></script>
