@model List<FireExtinViewModel>
@using CPC02.Models
@using Newtonsoft.Json
<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 15%">廠區</th>
            <th style="width: 15%">內容物</th>
            <th style="width: 15%">數量(瓶)</th>
            <th style="width: 15%">總量(公噸)</th>
            <th style="width: 15%">係數</th>
            <th style="width: 15%">計算結果</th>
            <th style="width: 15%">計算結果</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Factory</td>
                <td>@item.content</td>
                <td>@(item.SumFE002?.ToString("G29") ?? "N/A")</td>
                <td>@(item.Sumton?.ToString("G29") ?? "N/A")</td>
                <td>
                    <input type="text" v-model="searchQuery" class="form-control mb-3" placeholder="輸入搜尋詞..." />
                    <select v-model="selectedCoefficient" class="form-control" >
                        <option value="">請選擇係數</option>
                            <option v-for="option in filteredOptions"
                                :key="option.Id"
                                :value="option.Id">
                            {{ option.Label }}
                        </option>
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control" :value="calculateCarbonEmission(@(JsonConvert.SerializeObject(item.Sumton)))" readonly />
                    <span class="input-group-text">kgCo₂e/公噸</span>
                </td>
                <td>
                    <input type="text" class="form-control" :value="calculateCarbonEmission2(@(JsonConvert.SerializeObject(item.Sumton)))" readonly />
                    <span class="input-group-text">tonCo₂e/公噸</span>
                </td>
            </tr>
        }
    </tbody>
    <tfoot><tr><th colspan="2">合計</th><td>@((Model.Sum(x => x.SumFE002) ?? 0m).ToString("N2"))</td><td>@((Model.Sum(x => x.Sumton) ?? 0m).ToString("N2"))</td><td>—</td><td><input class="form-control" :value="calculateCarbonEmission(@(JsonConvert.SerializeObject(Model.Sum(x => x.Sumton))))" readonly /></td><td><input class="form-control" :value="calculateCarbonEmission2(@(JsonConvert.SerializeObject(Model.Sum(x => x.Sumton))))" readonly /></td></tr></tfoot>
</table>
