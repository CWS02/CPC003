@model List<CommutingViewModel>
@using CPC02.Models
@using Newtonsoft.Json
<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th>項目</th>
            <th>
                活動數據
                (總公里數)
            </th>
            <th style="width:150px">
                碳排係數
                ((kg CO2e/每延人公里))
            </th>
            <th style="width:150px">
                計算結果
                (kg CO2e/每延人公里)
            </th>
            <th style="width:150px">
                計算結果
                (ton CO2e/每延人公里)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TRANSPORTATION</td>
                <td>@(item.TotalDoubleKM)</td>
                <td>@item.EF_VALUE</td>
                <td>
                    <input type="text" class="form-control" value="@( ((item.TotalDoubleKM ?? 0m) * (item.EF_VALUE ?? 0m)).ToString("F4") )" readonly />
                    <span class="input-group-text">kgCo₂e/公噸</span>
                </td>
                <td>
                    <input type="text" class="form-control" value="@( (((item.TotalDoubleKM ?? 0m) * (item.EF_VALUE ?? 0m)) / 1000).ToString("F4") )" readonly />
                    <span class="input-group-text">tonCo₂e/公噸</span>
                </td>
            </tr>
        }
        <tr style="background-color:#f5f5f5;">
            <td colspan="3" class="text-end"></td>
            <td>
                @{
                    var totalKg = Model.Sum(x => (x.TotalDoubleKM ?? 0m) * (x.EF_VALUE ?? 0m));
                }
                <input type="text" class="form-control" value="@totalKg.ToString("F4")" readonly />
                <span class="input-group-text">kgCo₂e/公噸</span>
            </td>
            <td>
                @{
                    var totalTon = totalKg / 1000;
                }
                <input type="text" class="form-control" value="@totalTon.ToString("F4")" readonly />
                <span class="input-group-text">tonCo₂e/公噸</span>
            </td>
        </tr>
    </tbody>
</table>
